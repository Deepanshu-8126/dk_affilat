# =============================================================================
# Copy to .env and fill what you have. EVERYTHING is optional — missing values
# make that piece run in simulated/offline mode so the pipeline never breaks.
# =============================================================================

# ---- run behaviour ----
DRY_RUN=true               # true = simulate publishing (safe default)
REQUIRE_APPROVAL=true      # true = Telegram HITL gate before publishing
AUTO_APPROVE=false         # true = bypass approval entirely
LOG_LEVEL=INFO

# ---- BRAINS (free tiers) ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (1500 req/day)
GROQ_API_KEY=              # https://console.groq.com/keys       (30 req/min)
OLLAMA_BASE_URL=http://localhost:11434   # local Qwen3 via Ollama

# ---- RESEARCH / SEO ----
FIRECRAWL_API_KEY=         # https://firecrawl.dev (free tier)
OPEN_SEO_URL=              # self-hosted every-app/open-seo endpoint
DEEPTREND_FEED_URL=        # chrbailey/deeptrend JSON feed url

# ---- IMAGES ----
Z_IMAGE_URL=               # your Z-Image-Turbo /generate endpoint
ENABLE_POLLINATIONS=false  # true = use free pollinations.ai fallback

# ---- SITE 1: ai-tools-review.com ----
WP1_URL=
WP1_USER=
WP1_APP_PASSWORD=          # WordPress Application Password

# ---- SITE 2: ai-code-tutorial.com ----
WP2_URL=
WP2_USER=
WP2_APP_PASSWORD=

# ---- SITE 3: ai-automate.com ----
WP3_URL=
WP3_USER=
WP3_APP_PASSWORD=

# ---- SITE 4: ai-visual-lab.com ----
WP4_URL=
WP4_USER=
WP4_APP_PASSWORD=

# ---- SYNDICATION (backlinks with rel=canonical) ----
# Add _2 / _3 suffixes for multi-account rotation, e.g. DEVTO_API_KEY_2
DEVTO_API_KEY=
HASHNODE_TOKEN=
HASHNODE_PUBLICATION_ID=
MEDIUM_TOKEN=
SYNDICATE_HANDLE=your-handle

# ---- INDEXING ----
INDEXNOW_KEY=              # host <key>.txt at each domain root

# ---- APPROVAL (Telegram) ----
TELEGRAM_BOT_TOKEN=        # @BotFather
TELEGRAM_CHAT_ID=          # your chat id

# ---- ANALYTICS (learning loop) ----
GSC_CREDENTIALS=           # path to Search Console service-account JSON

# ---- MONETIZATION: AdSense ----
ADSENSE_PUBLISHER_ID=      # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_IN_ARTICLE=   # in-article ad slot id

# ---- MONETIZATION: Amazon Associates ----
AMAZON_ASSOCIATE_TAG=      # yourtag-20

# ---- MARKET STRATEGY: affiliate networks (join the ones that fit your niche) ----
MEESHO_AFFILIATE_ID=       # India physical products
IMPACT_AFFILIATE_ID=       # impact.com (SaaS/brands)
SHAREASALE_AFFILIATE_ID=   # ShareASale / Awin
PARTNERSTACK_AFFILIATE_ID= # recurring B2B SaaS
CLICKBANK_AFFILIATE_ID=    # ClickBank / Digistore24 (digital)
LEMONSQUEEZY_AFFILIATE_ID= # Lemon Squeezy / Gumroad (indie)
PRODUCT_TREND_FEED_URL=    # optional JSON feed of trending products
GITHUB_TOKEN=              # optional: higher GitHub API limits for live trend data
OPENMONTAGE_DIR=          # optional: local calesthio/OpenMontage checkout -> makes video briefs renderable (free stack)

# ---- AUTO-DISCOVERED (dynamic) niches share one WordPress target ----
WP_AUTO_URL=
WP_AUTO_USER=
WP_AUTO_APP_PASSWORD=

# ---- MONETIZATION: SaaS affiliate ids (fill the programs you join) ----
JASPER_AFFILIATE_ID=
COPYAI_AFFILIATE_ID=
WRITESONIC_AFFILIATE_ID=
NOTION_AFFILIATE_ID=
TABNINE_AFFILIATE_ID=
REPLIT_AFFILIATE_ID=
MAKE_AFFILIATE_ID=
ZAPIER_AFFILIATE_ID=
N8N_AFFILIATE_ID=
